[Unit]
Description=Intel DCAP Provisioning Certificate Caching Service
Documentation=https://github.com/KarpelesLab/intel-dcapd
After=network.target

[Service]
Type=simple
User=root
Environment="INTEL_API_KEY=@INTEL_API_KEY@"
ExecStart=@BINDIR@/intel-dcapd
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/root/.cache/intel-dcapd

[Install]
WantedBy=multi-user.target

[Unit]
Description=Intel DCAP Provisioning Certificate Caching Service
Documentation=https://github.com/KarpelesLab/intel-dcapd
After=network.target

[Service]
Type=simple
User=@PCCS_USER@
Group=@PCCS_USER@
Environment="INTEL_API_KEY=@INTEL_API_KEY@"
Environment="DCAPD_CACHE_DIR=@CACHE_DIR@"
ExecStart=@BINDIR@/intel-dcapd
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@CACHE_DIR@

[Install]
WantedBy=multi-user.target
